# OPTIONAL. The packaged service runs without this file:
#   sudo vaultline-worker enroll --control-plane-url <url>
# persists the Control Plane URL (worker.json) and the credential in
# /var/lib/docker-volume-backup, and the running service picks them up.
# Create /etc/docker-volume-backup/worker.env only for non-secret overrides;
# environment values always win over worker.json.
# Keep one-time enrollment material out of persistent package-managed files.
CONTROL_PLANE_URL=https://backups.example.com
WORKER_NAME=worker-linux-01
WORKER_RUNTIME=native
WORKER_RUN_ONCE=false
WORKER_POLL_INTERVAL_SECONDS=15
WORKER_HEALTH_PORT=8081
WORKER_CREDENTIAL_FILE=/var/lib/docker-volume-backup/worker_credentials.json
# Stop a backup that produced no output for this many seconds (default 900, 0 disables).
WORKER_RUNTIME_IDLE_TIMEOUT_SECONDS=900
# Optional absolute wall-clock limit per job. Unset means no limit.
#WORKER_RUNTIME_TIMEOUT_SECONDS=
