#!/bin/sh
set -e

case "$1" in
    configure)
        if ! getent group dvb-worker >/dev/null; then
            addgroup --system dvb-worker
        fi

        if ! getent passwd dvb-worker >/dev/null; then
            adduser --system --ingroup dvb-worker --home /var/lib/docker-volume-backup --no-create-home --disabled-login dvb-worker
        fi

        install -d -m 0750 -o root -g dvb-worker /etc/docker-volume-backup
        install -d -m 0700 -o dvb-worker -g dvb-worker /var/lib/docker-volume-backup

        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi

        # Start the service like tailscaled: it idles until an administrator
        # runs `vaultline-worker enroll`. Only act when systemd is the running
        # init (containers and chroots have no /run/systemd/system) and never
        # fail the package configuration because of a service-state problem.
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            if systemctl is-active --quiet docker-volume-backup-worker.service; then
                # Upgrade: the unit is already running the previous binary.
                systemctl restart docker-volume-backup-worker.service || true
            else
                systemctl enable --now docker-volume-backup-worker.service || true
            fi
        fi
        ;;
esac

exit 0
