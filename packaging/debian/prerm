#!/bin/sh
set -e

case "$1" in
    remove|upgrade)
        # A failed stop must abort dpkg before it removes/replaces the executable.
        # The unit's TimeoutStopSec bounds this wait; preserve enablement on upgrade.
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl stop docker-volume-backup-worker.service
            if [ "$1" = remove ]; then
                systemctl disable docker-volume-backup-worker.service || true
            fi
        fi
        ;;
esac

exit 0
