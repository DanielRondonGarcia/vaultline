<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vaultline Worker MSI (WiX v4/v5 schema).

  Install -> enroll flow (Tailscale-style):
    1. `msiexec /i vaultline-worker_<version>_windows-amd64.msi` installs
       vaultline-worker.exe under "Program Files\Vaultline", adds that folder to
       the system PATH, registers the Windows service "VaultlineWorker"
       (LocalSystem, auto-start, command line `vaultline-worker.exe service run`)
       and starts it. The service idles, logging "Waiting for enrollment" to
       %ProgramData%\Vaultline\worker\logs\worker.log, until it is enrolled.
    2. An administrator runs the enroll subcommand (see the service Description
       below for the exact command line), which writes the enrollment state
       into %ProgramData%\Vaultline\worker; the running service picks it up on
       its next poll without a restart.

  The state directory is marked Permanent so the enrollment state survives
  uninstall and reinstall/upgrade. The package ships no configuration file.
  %ProgramData% lets BUILTIN\Users create files, so the state and logs folders
  carry an explicit ACL (SYSTEM and Administrators only): a standard user must
  not be able to plant enrollment files for the LocalSystem service.

  The service is configured to restart on failure (util:ServiceConfig), so a
  worker process that exits with an error is brought back by the SCM.

  Build (CI; the Util extension must be added first with
  `wix extension add -g WixToolset.Util.wixext/<wix version>`):
    wix build -arch x64 -ext WixToolset.Util.wixext -d Version=<semver> -d WorkerExe=dist\vaultline-worker.exe \
      -o dist\release\vaultline-worker_<semver>_windows-amd64.msi packaging\windows\vaultline-worker.wxs
-->
<?ifndef Version ?>
  <?error Version must be defined: wix build -d Version=<semver> ?>
<?endif?>
<?ifndef WorkerExe ?>
  <?define WorkerExe = "dist\vaultline-worker.exe" ?>
<?endif?>
<?ifndef ResticLicense ?>
  <?define ResticLicense = "packaging\licenses\restic-v0.19.1-LICENSE" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Vaultline Worker"
      Manufacturer="Vaultline"
      Version="$(var.Version)"
      UpgradeCode="61D954FF-093C-408B-8764-78834B55FAA2"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes"
      Language="1033">

    <!-- Remove the old product during execute so its ServiceControl stop/remove
         runs before the shared install path is replaced by the new executable. -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Vaultline Worker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="WorkerFeature" Title="Vaultline Worker" Level="1">
      <ComponentRef Id="WorkerExecutable" />
      <ComponentRef Id="ResticLicense" />
      <ComponentRef Id="WorkerStateDir" />
      <ComponentRef Id="WorkerLogsDir" />
    </Feature>

    <!-- Program Files\Vaultline: binary, service registration, PATH entry. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vaultline">
        <Component Id="WorkerExecutable">
          <File Id="WorkerExe" Source="$(var.WorkerExe)" Name="vaultline-worker.exe" KeyPath="yes" />
          <ServiceInstall
              Id="VaultlineWorkerService"
              Name="VaultlineWorker"
              DisplayName="Vaultline Worker"
              Description="Vaultline native backup worker (enroll with: vaultline-worker enroll --control-plane-url &lt;url&gt;)"
              Type="ownProcess"
              Start="auto"
              ErrorControl="normal"
              Account="LocalSystem"
              Arguments="service run"
              Vital="yes" />
          <ServiceControl
              Id="VaultlineWorkerServiceControl"
              Name="VaultlineWorker"
              Start="install"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
          <!-- SCM recovery: the service host exits with a non-zero code on an
               unhandled worker error so these actions fire. -->
          <util:ServiceConfig
              ServiceName="VaultlineWorker"
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="10"
              ResetPeriodInDays="1" />
          <Environment
              Id="WorkerPathEntry"
              Name="PATH"
              Value="[INSTALLFOLDER]"
              Action="set"
              Part="last"
              System="yes" />
        </Component>
        <Directory Id="ResticLicenseFolder" Name="licenses">
          <Component Id="ResticLicense" Guid="4B47AF58-9322-4E72-B76A-3F96474B1B40">
            <File Id="ResticLicenseFile" Source="$(var.ResticLicense)" Name="restic-v0.19.1-LICENSE" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!--
      %ProgramData%\Vaultline\worker: state written by `enroll` and by the
      service (worker.log). Permanent: never removed on uninstall.
      The protected PermissionEx DACL prevents inherited grants; only SYSTEM
      (the service) and Administrators (who run `enroll`) can access this tree.
    -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VaultlineDataDir" Name="Vaultline">
        <Directory Id="WorkerStateFolder" Name="worker">
          <Component Id="WorkerStateDir" Guid="3029A7D9-EDF5-4832-ACA0-56E18F08D1CC" Permanent="yes">
            <CreateFolder>
              <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
            </CreateFolder>
          </Component>
          <Directory Id="WorkerLogsFolder" Name="logs">
            <Component Id="WorkerLogsDir" Guid="85FD8EDB-5E1D-4DB1-8BF9-9DB052800D14" Permanent="yes">
              <CreateFolder>
                <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
              </CreateFolder>
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
